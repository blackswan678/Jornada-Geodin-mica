// Posições das 45 casas em espiral (x%, y%) - de fora para dentro
const CELL_POSITIONS = [
  null, // índice 0 não usado
  [5, 85], [16, 85], // 1-2
  [27, 85], [38, 85], [49, 85], [60, 85], [71, 85], [82, 85], // 3-8 (topo da primeira linha? não, base)
  // Reorganizando em espiral real:
];

// Espiral: começa em (5,85) e vai para o centro
// Caminho: direita pela base, sobe pela direita, esquerda pelo topo, desce pela esquerda, repete
const POSITIONS = [
  null,
  // Casa 1-8: base indo para direita
  [5, 85], [16, 85], [27, 85], [38, 85], [49, 85], [60, 85], [71, 85], [82, 85],
  // Casa 9-15: sobe pelo lado direito
  [82, 73], [82, 61], [82, 49], [82, 37], [82, 25], [82, 13], [82, 5],
  // Espera... vou refazer em grid 9x9 com espiral clara

];

// Vou redefinir com uma espiral clara em grid 9x9
// Grid: colunas 0-8, linhas 0-8 (0=topo)
// Espiral começa em (0,8) inferior-esquerda, vai para direita, sobe, esquerda, desce, repete
const GRID_POS = [
  null,
  // 1-8: linha 8 (base), da col 0 até col 7
  {c:0,r:8},{c:1,r:8},{c:2,r:8},{c:3,r:8},{c:4,r:8},{c:5,r:8},{c:6,r:8},{c:7,r:8},
  // 9-15: coluna 7, da linha 7 até linha 0 (sobe)
  {c:7,r:7},{c:7,r:6},{c:7,r:5},{c:7,r:4},{c:7,r:3},{c:7,r:2},{c:7,r:1},
  // 16-22: linha 1, da col 6 até col 1 (esquerda) - topo
